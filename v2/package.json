{
  "name": "bunkmeter-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm test && npm run build",
    "build:android": "astro build --config astro.mobile.config.mjs && node scripts/secure-mobile.mjs && cap sync android",
    "open:android": "cap open android"
  },
  "overrides": { "xcode": { "uuid": "11.1.1" } },
  "dependencies": {
    "@astrojs/preact": "6.0.5",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "astro": "7.3.4",
    "preact": "10.29.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
