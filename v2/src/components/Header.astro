---
import ProductNav from './ProductNav';
import '../styles/product.css';
const { home = false } = Astro.props;
---
<header class="site-header wrap">
  <a class="brand" href="/" aria-label="BunkMeter home"><svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><circle cx="16" cy="16" r="15" fill="currentColor"/><path d="M9 23a10 10 0 1 1 14 0" fill="none" stroke="#f2e5bc" stroke-width="2.5" stroke-linecap="round"/><path d="m21 11-5 5" stroke="#e6b667" stroke-width="2.5" stroke-linecap="round"/><circle cx="16" cy="16" r="2" fill="#e6b667"/></svg><span>BunkMeter<span class="brand-dot">.</span></span></a>
  <ProductNav base={home ? '' : '/'} client:load />
  <span class="header-storage">No account needed</span>
</header>
<style>
 .site-header{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:78px;border-bottom:1px solid var(--line)}
 .brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-size:22px;font-weight:700;letter-spacing:-.9px}.brand-dot{color:var(--green)}
 nav{display:flex;gap:30px;font-size:13px}nav a{min-height:44px;display:flex;align-items:center;gap:8px;text-decoration:none;color:var(--muted)}nav a[aria-current]{color:var(--ink);font-weight:600}nav a:hover{text-decoration:underline}
 @media(max-width:700px){.site-header{min-height:60px;gap:12px}.brand{font-size:20px;gap:8px}.brand svg{width:27px;height:27px}nav{gap:14px;font-size:12px}nav a[aria-current],nav a span{display:none}}
</style>
