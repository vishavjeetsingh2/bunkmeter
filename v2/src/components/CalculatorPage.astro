---
import Shell from '../layouts/Shell.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Calculator from '../features/calculator/Calculator';
import Advertisement from './Advertisement.astro';
import Icon from './Icon';
import { attendanceFaq } from '../content/faq';
import { universities, type UniversityPage } from '../content/universities';
interface Props { university?: UniversityPage }
const { university } = Astro.props;
const path = university ? `/${university.slug}` : '/';
const metadata = university ? { title: university.title, description: university.description } : {};
const calculatorProps = university ? { defaultTarget: university.defaultTarget, presets: university.presets, targetHelp: university.targetHelp } : {};
---
<Shell {...metadata} path={path} faq={true}>
  <Header home={true} />
  <main id="main" class="wrap" tabindex="-1">
    <div class="page-intro"><div><p class="intro-kicker">Attendance calculator · Bunk budget & recovery</p><h1>{university ? university.heading : <>Your attendance.<br class="mobile-break" /> <span>In perspective.</span></>}</h1></div><p>Every class changes the picture.<br />Know your next move.</p></div>
    {university && <p class="university-preset-note">{university.lead}</p>}
    <Calculator client:load {...calculatorProps} sharePath={path} />
    <Advertisement />
    <noscript><p class="noscript">JavaScript is needed for this calculator. You can still calculate your percentage: attended ÷ held × 100. Enable JavaScript to get recovery and allowance results.</p></noscript>
    {university && <article class="university-guide" aria-labelledby="university-guide-title"><h2 id="university-guide-title">{university.sectionTitle}</h2>{university.sections.map(section => <section><h3>{section.heading}</h3><p>{section.text}</p></section>)}<p>Source: <a href={university.source.url}>{university.source.label}</a>.</p><aside><p>BunkMeter is independent and is not affiliated with {university.shortName}. Check your current course rules and official record; this page does not decide examination eligibility.</p></aside></article>}
    <span id="faq" aria-hidden="true"></span><section class="how-section" id="how-it-works" aria-labelledby="how-title">
      <div class="how-intro"><span class="eyebrow">Good to know</span><h2 id="how-title">How it works.</h2><p>A percentage is the starting point.<br />Here’s what the next step means.</p></div>
      <div class="how-cards"><article><Icon name="calculator"/><h3>Your attendance</h3><p>Enter held and attended counts.</p></article><article><Icon name="target"/><h3>Your target</h3><p>Use your course’s requirement.</p></article><article><Icon name="calendar"/><h3>Spare classes</h3><p>Know what you can miss.</p></article><article><Icon name="target"/><h3>Recovery</h3><p>A clear run back to your target.</p></article></div>
      <div class="explanations">
        {attendanceFaq.map(item => <details id={item.id}><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}
      </div>
    </section>
    <p class="calculation-guide-link">Attendance = attended ÷ held × 100. At 72 of 100 classes, a 75% target needs 12 consecutive attended classes: 84 of 112. <a href="/attendance-calculator-guide">See the formulas and worked examples →</a></p>
    <nav class="university-links" aria-label="University attendance calculators"><span>University calculators:</span>{universities.map(item => <a href={`/${item.slug}`} aria-current={university?.slug === item.slug ? 'page' : undefined}>{item.shortName}</a>)}{university && <a href="/">All students</a>}</nav>
  </main>
  <Footer />
</Shell>

<style>
  .calculation-guide-link { max-width:78ch; font-size:13px; line-height:1.8; color:var(--muted); margin-top:24px; }
  .university-preset-note { font-size:13px; line-height:1.6; color:var(--muted); max-width:78ch; margin:0 0 20px; }
  .university-guide { margin-top:40px; padding-top:24px; border-top:1px solid var(--line); max-width:78ch; }
  .university-guide h2 { font-size:23px; letter-spacing:-.7px; }
  .university-guide h3 { font-size:16px; margin:22px 0 8px; }
  .university-guide p { font-size:13px; line-height:1.8; color:var(--muted); margin:10px 0; }
  .university-guide aside { border-left:3px solid var(--line); padding-left:14px; }
  .university-links { display:flex; flex-wrap:wrap; align-items:center; gap:4px 18px; font-size:12px; color:var(--muted); margin-top:24px; }
  .university-links a { display:inline-flex; align-items:center; min-height:44px; }
  .page-intro { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding: 24px 0 20px; }
  .intro-kicker { font-size: 11px; font-weight: 500; color: var(--green); }
  h1 { margin-top: 6px; font-size: clamp(26px,3vw,38px); line-height: 1.15; letter-spacing: -1.5px; font-weight: 600; }
  h1 > span { color:var(--muted); font-weight:400; }
  .page-intro > p:last-child { font-size: 12px; color: var(--muted); padding-bottom: 3px; line-height: 1.6; }
  .mobile-break { display: none; }
  .how-section { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--line); }
  .how-cards { display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px; }
  .how-cards article { padding:20px;border:1px solid var(--line);border-radius:var(--card-radius);background:var(--surface); }
  .how-cards article :global(.ui-icon) { padding:10px;width:42px;height:42px;border-radius:50%;background:var(--green-soft);color:var(--green); }
  .how-cards h3 { font-size:15px;font-weight:550;margin:12px 0 4px; }
  .how-cards p { color:var(--muted);font-size:12px; }
  .explanations { background:var(--surface);border:1px solid var(--line);border-radius:var(--card-radius);padding:6px 22px; }
  .how-section h2 { font-size: 23px; font-weight: 550; letter-spacing: -.7px; margin-top: 9px; }
  .how-section > div > p { color: var(--muted); font-size: 13px; margin-top: 12px; }
  .explanations details { border-bottom: 1px solid var(--line); }
  .explanations summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 17px 0; min-height: 54px; cursor: pointer; list-style: none; font-size: 14px; }
  .explanations summary::-webkit-details-marker { display: none; }
  .explanations summary > span { color: var(--muted); font-size: 20px; }
  .explanations details[open] summary > span { transform: rotate(45deg); }
  .explanations details > p { padding: 0 24px 18px 0; color: var(--muted); font-size: 13px; line-height: 1.7; }
  .noscript { border: 1px solid var(--red); padding: 16px; margin-top: 16px; }
  @media(prefers-reduced-motion:no-preference) {
    h1 > span { display:inline-block; animation:perspective-arrival 900ms cubic-bezier(.16,1,.3,1) both; }
    .intro-kicker { animation:perspective-arrival 700ms cubic-bezier(.16,1,.3,1) both; }
    @supports(animation-timeline:view()) {
      .how-section { animation:explanation-arrival linear both; animation-timeline:view(); animation-range:entry 0% entry 85%; }
    }
  }
  @keyframes perspective-arrival { from { transform:translateY(10px); } to { transform:translateY(0); } }
  @keyframes explanation-arrival { from { transform:translateY(18px); } to { transform:translateY(0); } }
  @media (max-width: 700px) {
    .page-intro { padding: 12px 0; }
    .intro-kicker { display: none; }
    h1 { font-size: 24px; letter-spacing: -.9px; margin-top: 0; }
    h1 > span { letter-spacing:-1.1px; }
    .mobile-break { display: none; }
    .page-intro > p:last-child { display: none; }
    .how-section { grid-template-columns: 1fr; gap: 12px; margin-top: 34px; padding-top: 25px; }
    .how-section > div > p { display: none; }
    .how-section h2 { font-size: 22px; }
    .how-cards { grid-template-columns:repeat(2,minmax(0,1fr));gap:10px; }
    .how-cards article { padding:16px;border-radius:20px; }
    .how-cards h3 { font-size:13px; }
    .how-cards p { font-size:11px; }
  }
</style>
