---
import Shell from './Shell.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; path: string; eyebrow?: string; noindex?: boolean; }
const { title, description, path, eyebrow = 'BunkMeter', noindex = false } = Astro.props;
---
<Shell title={`${title} | BunkMeter`} description={description} path={path} noindex={noindex}>
  <Header />
  <main id="main" class="content wrap" tabindex="-1">
    <p class="kicker">{eyebrow}</p><h1>{title}</h1><p class="lede">{description}</p>
    <div class="prose"><slot /></div>
    <a class="return-link" href="/#calculator">Back to the calculator <span aria-hidden="true">↗</span></a>
  </main><Footer />
</Shell>
<style>
 .content{max-width:820px;padding-top:48px}.kicker{font-size:12px;color:var(--green);letter-spacing:.1em;text-transform:uppercase}h1{font:italic 400 clamp(36px,6vw,60px)/1.1 Georgia,serif;letter-spacing:-1.5px;margin:14px 0 20px}.lede{max-width:64ch;color:var(--muted);font-size:18px;line-height:1.65}.prose{margin-top:38px;border-top:1px solid var(--line);padding-top:8px}.prose :global(h2){font-size:22px;line-height:1.3;letter-spacing:-.4px;margin:28px 0 12px}.prose :global(p),.prose :global(li){max-width:72ch;line-height:1.8;overflow-wrap:anywhere}.prose :global(p){margin:12px 0}.prose :global(ul){padding-left:24px}.prose :global(li){margin:8px 0}.prose :global(.notice){border-left:3px solid var(--green);padding:12px 20px;background:var(--green-soft)}.return-link{display:inline-flex;align-items:center;gap:16px;min-height:48px;margin-top:24px;font-weight:600}.prose :global(.updated){color:var(--muted);font-size:12px}
 @media(max-width:700px){.content{padding-top:28px}.lede{font-size:16px}.prose{margin-top:24px}.prose :global(h2){font-size:20px}}
</style>
