---
import '../styles/tokens.css';
import { siteUrl, productionRelease } from '../site';
import { faqSchema } from '../content/faq';
interface Props { title?: string; description?: string; path?: string; noindex?: boolean; faq?: boolean; }
const { title = 'Attendance Calculator — Bunk Budget & Recovery | BunkMeter', description = 'Calculate how many classes you can miss or must attend to reach your attendance target. Check remaining lectures and explore what-if scenarios for free.', path = '/', noindex = false, faq = false } = Astro.props;
const canonical = new URL(path, siteUrl).href;
const schema = path === '/' ? { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'BunkMeter', url: siteUrl + '/', applicationCategory: 'EducationalApplication', operatingSystem: 'Web browser', description, offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' } } : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={productionRelease && !noindex ? 'index, follow' : 'noindex, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BunkMeter" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${siteUrl}/og-preview.png`} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="BunkMeter attendance calculator — know what you can miss and what you must attend." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-preview.png`} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    {faq && <script type="application/ld+json" data-faq-schema set:html={JSON.stringify(faqSchema).replace(/</g, '\\u003c')} />}
    <meta name="theme-color" content="#f5f4ee" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="bunkmeter-product">
    <a class="skip-link" href="#main">{path === '/' ? 'Skip to calculator' : 'Skip to content'}</a>
    <slot />
  </body>
</html>
